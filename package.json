    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:supplier": "node scripts/browser-supplier-flow.mjs",
    "test:browser:reseller": "node scripts/browser-reseller-flow.mjs",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
